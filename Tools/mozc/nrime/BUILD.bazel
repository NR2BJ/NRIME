# NRIME's C API over Mozc. Tools/mozc/build.sh copies this folder into the
# Mozc source tree as src/nrime and builds it there.
load("//:build_defs.bzl", "mozc_cc_binary", "mozc_cc_library")

mozc_cc_library(
    name = "nrime_mozc",
    srcs = ["nrime_mozc.cc"],
    hdrs = ["nrime_mozc.h"],
    # Nothing in the library calls the API; keep it in the shared library.
    alwayslink = True,
    deps = [
        "//base:system_util",
        "//base:version",
        "//data_manager",
        "//engine",
        "//engine:engine_interface",
        "//protocol:commands_cc_proto",
        "//session:session_handler",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/synchronization",
    ],
)

# The engine NRIME loads at run time — bundled in the app, or a newer one the
# input method downloaded (built by .github/workflows/mozc-component.yml).
# Only the C API is exported, so Mozc and its dependencies cannot clash with
# anything else in the process.
mozc_cc_binary(
    name = "libnrime_mozc.dylib",
    linkopts = [
        "-Wl,-install_name,@rpath/libnrime_mozc.dylib",
        "-Wl,-dead_strip",
        "-Wl,-exported_symbol,_nrime_mozc_abi_version",
        "-Wl,-exported_symbol,_nrime_mozc_new",
        "-Wl,-exported_symbol,_nrime_mozc_free",
        "-Wl,-exported_symbol,_nrime_mozc_eval",
        "-Wl,-exported_symbol,_nrime_mozc_free_buffer",
        "-Wl,-exported_symbol,_nrime_mozc_version",
    ],
    linkshared = True,
    deps = [":nrime_mozc"],
)
